# Discordのチャンネル設定で作成したWebhook URL
DISCORD_WEBHOOK_URL=

# GoogleサービスアカウントJSONの全文、またはそのBase64文字列
GOOGLE_SERVICE_ACCOUNT_JSON=

# 登録先GoogleカレンダーのID
GOOGLE_CALENDAR_ID=

# 取得先へ示す連絡先。公開リポジトリURLを推奨
MONITOR_USER_AGENT_CONTACT=https://github.com/nekoromme/regional-cashless-monitor

# ローカル実行時だけ使用。GitHub Actionsでは自動設定される
STATE_FILE=state/state.json
LOG_DIR=logs
